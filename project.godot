; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NEUQ-GameJam"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://b352vc4e74a37"

[autoload]

QuestSystem="*uid://b77kvbliweux5"
ProjectUISoundController="*uid://cc37235kj4384"
SceneLoader="*uid://cpehcs7n5c62p"
ProjectMusicController="*uid://r5t485lr3p7t"
DialogueManager="*uid://c3rodes2l3gxb"
GameState="*res://scripts/autoload/game_state.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
QuestTracker="*res://scripts/autoload/quest_tracker.gd"
QuestBook="*res://scenes/quest_book.tscn"

[clean_copy_examples]

examples_paths=Array[String](["res://addons/maaacks_scene_loader/examples/", "res://addons/maaacks_menus_template/examples/"])
copy_path="res://"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/dialogue_balloon.tscn"
runtime/state_autoload_shortcuts=["GameState"]

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/maaacks_menus_template/plugin.cfg", "res://addons/maaacks_music_controller/plugin.cfg", "res://addons/maaacks_scene_loader/plugin.cfg", "res://addons/maaacks_ui_sound_controller/plugin.cfg", "res://addons/quest_system/plugin.cfg")

[gui]

theme/custom_font="uid://cx1tl35io152i"

