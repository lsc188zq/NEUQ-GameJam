[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_menus_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_menus_template/base/translations/menus_translations.fr.translation")
locale/translations_pot_files=PackedStringArray("res://content/dialogues/npc_green.dialogue", "res://content/dialogues/books.dialogue", "res://content/dialogues/desk_wood.dialogue", "res://content/dialogues/chair_wood.dialogue", "res://content/dialogues/bookshelf.dialogue", "res://content/dialogues/MapWorld.dialogue", "res://content/dialogues/chore_desks.dialogue", "res://content/dialogues/BulletinBoard.dialogue", "res://content/dialogues/PlantSmall.dialogue", "res://content/dialogues/Lamp.dialogue", "res://content/dialogues/Cabinet.dialogue", "res://content/dialogues/Terminal.dialogue", "res://content/dialogues/Locker.dialogue", "res://content/dialogues/Clock.dialogue", "res://content/dialogues/PosterWall.dialogue", "res://content/dialogues/BlackBoard.dialogue", "res://content/dialogues/PlantPalm.dialogue", "res://content/dialogues/chair_key.dialogue")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="wall"
2d_physics/layer_3="npc"
2d_physics/layer_4="interactable"

[maaacks_menus_template]

disable_install_wizard=true
main_menu_scene_path="res://scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://scenes/world/world.tscn"
ending_scene_path="res://scenes/end_credits/end_credits.tscn"
copy_path="res://"

[maaacks_music_controller]

disable_install_audio_busses=true

[maaacks_scene_loader]

loading_scene_path="res://scenes/loading_screens/loading_screen.tscn"

[maaacks_ui_sound_controller]

disable_install_audio_busses=true

[physics]

3d/physics_engine="Jolt Physics"

[plugin_updater]

plugins={
"res://addons/maaacks_menus_template/": "https://github.com/Maaack/Godot-Menus-Template",
"res://addons/maaacks_music_controller/": "https://github.com/Maaack/Godot-Music-Controller",
"res://addons/maaacks_scene_loader/": "https://github.com/Maaack/Godot-Scene-Loader",
"res://addons/maaacks_ui_sound_controller/": "https://github.com/Maaack/Godot-UI-Sound-Controller"
}

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
